# Supabase Configuration
# 이 파일을 복사해서 .env.local 을 만들고 값을 채우세요. (.env.local 은 git에 올리지 않습니다)
# 값은 Supabase 대시보드 > Project Settings > API 에서 확인할 수 있습니다.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Toss Payments (결제위젯)
# 테스트는 토스 문서의 공개 테스트 키를 쓰면 됩니다: https://docs.tosspayments.com/reference/using-api/api-keys
# TOSS_SECRET_KEY 는 서버에서만 쓰고 절대 NEXT_PUBLIC_ 을 붙이지 않습니다.
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_gck_xxxxxxxx
TOSS_SECRET_KEY=test_gsk_xxxxxxxx
